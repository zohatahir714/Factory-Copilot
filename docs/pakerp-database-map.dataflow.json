  "cards": [
    {
      "dot": "emerald",
      "title": "Commerce Spine",
      "items": [
        "Suppliers commit through purchase orders; receipts raise product stock",
        "Dispatch decrements stock and issues an 18% GST invoice per sale",
        "Customers and suppliers are soft-referenced (ON DELETE SET NULL)"
      ]
    },
    {
      "dot": "violet",
      "title": "Double-Entry Core",
      "items": [
        "Every commercial event lands in cashbook_entries as CRV, CPV, or JV",
        "chart_of_accounts supplies the GL coding for each voucher leg",
        "inventory_movements preserves an append-only audit of stock deltas"
      ]
    },
    {
      "dot": "rose",
      "title": "Governance Boundary",
      "items": [
        "organizations is the tenant root; profiles carry RBAC roles",
        "RLS keys every table to the organization — anon writes are denied",
        "app_settings stores branding, Groq model config, and org preferences"
      ]
    }
  ]
