# ============================================================
# PakERP Cloud Suite — Environment Configuration
# ============================================================
# SECURITY MODEL (PRD §40): the Groq key is SERVER-SIDE ONLY.
# It is read exclusively by the /api/groq/* serverless functions
# and is never bundled into client JavaScript.
#
# Local development: copy this file to .env (gitignored) —
# scripts/dev.mjs loads it before starting the API emulator.
#
# Production (Vercel): add these in Project Settings →
# Environment Variables. Never commit real keys.
# ============================================================

# GROQ_API_KEY: Server-side only. Powers Llama-3.3 70B chat and
# Whisper large-v3 transcription via /api/groq/* proxies.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=""

# VITE_SUPABASE_URL: Supabase project URL (public, client-safe).
VITE_SUPABASE_URL=""

# VITE_SUPABASE_ANON_KEY: Supabase public anon key (client-safe).
VITE_SUPABASE_ANON_KEY=""

# GEMINI_API_KEY: Optional secondary engine (server-side only).
GEMINI_API_KEY=""
